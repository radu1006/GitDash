captures/
.externalNativeBuild/
.cxx/

# --- Signing material: never commit keys or their passwords ---
*.jks
*.keystore
keystore.properties
signing.properties

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Logs and crash dumps ---
*.log
hs_err_pid*
